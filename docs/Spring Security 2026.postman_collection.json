    {
      "name": "Authentication Provider 04",
      "item": [
        {
          "name": "Get Me - Juan (Api Key Auth Provider)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response identifies juan\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"juan\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "service-key-juan"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/me",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "response": []
        },
